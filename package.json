{
  "name": "ink-and-shell",
  "private": true,
  "version": "1.0.0",
  "description": "Ink & Shell — learn Bash scripting for defensive security in 21 days.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
